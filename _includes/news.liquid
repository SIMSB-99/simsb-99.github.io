<div class="news">
  {% if site.news != blank %}
    {% assign visible_news = site.news | where_exp: "item", "item.site_visible != false" %}
    {% assign news_size = visible_news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = visible_news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" class="news-date">
              {% if item.display_date %}
                {{ item.display_date }}
              {% else %}
                {{ item.date | date: '%B %-d, %Y' }}
              {% endif %}
            </th>
            <td>
              {% if item.inline %}
                <div class="news-content">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</div>
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
              {% if item.tags %}
                <div class="news-tags" aria-label="News categories">
                  {% for tag in item.tags %}
                    <span class="news-tag news-tag--{{ tag | slugify }}">{{ tag }}</span>
                  {% endfor %}
                </div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
